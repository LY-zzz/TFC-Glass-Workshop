    {
      "type": "patchouli:text",
      "text": "The press uses one mold to decide the shape of the glass. Metal molds are permanent. Ceramic molds are cheaper, but each pressing has a chance to break them."
    },
    {
      "type": "tfc:anvil_recipe",
      "recipe": "tfc_glass_workshop:anvil/wrought_iron_plate_mold",
      "text": "Wrought iron molds are made on an anvil from wrought iron sheets. They are permanent."
    },
    {
      "type": "tfc:anvil_recipe",
      "recipe": "tfc_glass_workshop:anvil/steel_plate_mold",
      "text": "Steel molds work the same way as wrought iron molds, using steel sheets and a higher anvil tier."
    },
    {
      "type": "tfc:heat_recipe",
      "recipe": "tfc_glass_workshop:heating/plate_mold",
      "text": "Fire an unfired mold to make the ceramic version."
